# Copie para .env. O arquivo .env real já é ignorado pelo Git.
POSTGRES_DB=reelz
POSTGRES_USER=reelz
POSTGRES_PASSWORD=troque-por-uma-senha-forte

# Gere com: openssl rand -base64 32
JWT_SECRET=troque-por-uma-chave-base64-de-32-bytes
JWT_ISSUER=reelz-api
JWT_EXPIRATION=PT2H

# Contas que receberão acesso à dashboard administrativa.
ADMIN_EMAILS=seu-email@exemplo.com
ANALYTICS_RETENTION_DAYS=180

BACKEND_PORT=8080
FRONTEND_PORT=80
PUBLIC_APP_URL=http://localhost

# LOG imprime o link no log local. Para um beta publico use SMTP e credenciais reais.
ACCOUNT_MAIL_MODE=LOG
MAIL_FROM=no-reply@reelz.app
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_STARTTLS=false
EMAIL_VERIFICATION_TTL=PT24H
PASSWORD_RESET_TTL=PT30M
ACCOUNT_TOKEN_COOLDOWN=PT1M
BACKUP_RETENTION_DAYS=14
# No deploy publico: use prod, SMTP e uma PUBLIC_APP_URL com HTTPS.
SPRING_PROFILES_ACTIVE=default

# Deixe vazio para usar o proxy /api do Nginx.
VITE_API_URL=

# Token Bearer obtido nas configurações de API do TMDB. Nunca use VITE_*.
TMDB_READ_ACCESS_TOKEN=
TMDB_LANGUAGE=pt-BR
TMDB_REGION=BR
TMDB_PAGES_PER_PROVIDER=3
TMDB_MAX_PROVIDERS=10
# Netflix, Prime Video, Apple TV, Disney+, Paramount+, Max, Globoplay, Crunchyroll, MUBI e Pluto TV.
TMDB_PROVIDER_IDS=8,119,350,337,531,1899,307,283,11,300
TMDB_SYNC_ON_STARTUP=false
TMDB_SCHEDULED_SYNC_ENABLED=false
TMDB_SYNC_CRON=0 0 4 * * *
TMDB_SYNC_ZONE=America/Sao_Paulo
TMDB_SYNC_LEASE_DURATION=PT30M
TMDB_MAX_ATTEMPTS=3
TMDB_RETRY_BASE_DELAY=PT0.25S
TMDB_CONNECT_TIMEOUT=PT5S
TMDB_READ_TIMEOUT=PT15S

# Streaming Availability API by Movie of the Night. A chave fica somente no backend.
# Durante a validação, mantenha TMDB_SCHEDULED_SYNC_ENABLED=false para evitar duas fontes
# atualizando o mesmo catálogo. O idioma pt-BR ainda não é suportado pela API.
STREAMING_AVAILABILITY_ENABLED=false
STREAMING_AVAILABILITY_API_KEY=
STREAMING_AVAILABILITY_BASE_URL=https://api.movieofthenight.com/v4
STREAMING_AVAILABILITY_COUNTRY=BR
STREAMING_AVAILABILITY_OUTPUT_LANGUAGE=en
STREAMING_AVAILABILITY_CATALOGS=netflix.subscription,prime.subscription,disney.subscription,hbo.subscription,apple.subscription,paramount.subscription,mubi.subscription,curiosity.subscription,plutotv.free,crunchyroll.subscription
# 20 páginas x 20 filmes = até 400 filmes por execução de bootstrap.
STREAMING_AVAILABILITY_BOOTSTRAP_PAGES_PER_RUN=20
STREAMING_AVAILABILITY_CHANGES_PAGES_PER_RUN=10
# Ative somente no corte definitivo; provedores ausentes (como Globoplay) serão desativados.
STREAMING_AVAILABILITY_DEACTIVATE_UNCONFIGURED_PROVIDERS=false
STREAMING_AVAILABILITY_SYNC_ON_STARTUP=false
STREAMING_AVAILABILITY_SCHEDULED_SYNC_ENABLED=false
STREAMING_AVAILABILITY_SYNC_CRON=0 0 4 * * *
STREAMING_AVAILABILITY_SYNC_ZONE=America/Sao_Paulo
STREAMING_AVAILABILITY_SYNC_LEASE_DURATION=PT30M
STREAMING_AVAILABILITY_MAX_ATTEMPTS=3
STREAMING_AVAILABILITY_RETRY_BASE_DELAY=PT0.25S
STREAMING_AVAILABILITY_CONNECT_TIMEOUT=PT5S
STREAMING_AVAILABILITY_READ_TIMEOUT=PT20S

# Fonte usada pela roleta: ALL, TMDB ou STREAMING_AVAILABILITY.
ROULETTE_CATALOG_SOURCE=ALL

# Pagamentos AbacatePay. A chave privada fica apenas no backend.
ABACATEPAY_ENABLED=false
ABACATEPAY_API_KEY=
ABACATEPAY_WEBHOOK_SECRET=
# Chave HMAC pública informada pela documentação/painel da AbacatePay.
ABACATEPAY_WEBHOOK_HMAC_KEY=
ABACATEPAY_MONTHLY_PRODUCT_ID=
ABACATEPAY_ANNUAL_PRODUCT_ID=
# Use CARD inicialmente. Adicione PIX somente quando estiver habilitado para assinaturas na conta.
ABACATEPAY_METHODS=CARD
ABACATEPAY_ACCEPT_DEV_EVENTS=false
REELZ_PREMIUM_MONTHLY_PRICE_CENTS=1290
REELZ_PREMIUM_ANNUAL_PRICE_CENTS=9990
